{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/biome/core", "ultracite/biome/vue"],
  "files": {
    "includes": [
      "!app/lib/linear/generated",
      "!graphql",
      "!**/.nuxt",
      "!**/.output",
      "!**/.wrangler",
      "!test-results",
      "!playwright-report"
    ]
  },
  "overrides": [
    {
      // Route components are named by Nuxt's file-based routing, not reused.
      "includes": ["app/pages/**", "app/app.vue", "app/error.vue"],
      "linter": {
        "rules": {
          "style": { "useVueMultiWordComponentNames": "off" }
        }
      }
    }
  ]
}
