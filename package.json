{
  "name": "triage-syn-horse",
  "version": "0.1.0",
  "private": true,
  "description": "A mobile-first web app for triaging Linear issues.",
  "type": "module",
  "scripts": {
    "build": "pnpm exec nuxt build",
    "check": "pnpm exec ultracite check",
    "codegen": "pnpm exec graphql-codegen --config codegen.ts",
    "deploy": "pnpm run verify && pnpm run generate && pnpm exec wrangler deploy",
    "dev": "pnpm exec nuxt dev",
    "fix": "pnpm exec ultracite fix",
    "format": "pnpm exec ultracite fix",
    "generate": "pnpm exec nuxt generate",
    "postgenerate": "node scripts/generate-headers.ts .output/public",
    "postinstall": "pnpm exec nuxt prepare",
    "lint": "pnpm exec ultracite check",
    "preview": "pnpm exec wrangler dev --port 8788",
    "schema:update": "node scripts/update-schema.ts",
    "test": "pnpm exec vitest run",
    "test:e2e": "pnpm exec playwright test",
    "test:live": "pnpm exec vitest run --config vitest.live.config.ts",
    "test:watch": "pnpm exec vitest",
    "typecheck": "pnpm exec nuxt typecheck",
    "verify": "pnpm run lint && pnpm run typecheck && pnpm run test"
  },
  "dependencies": {
    "@pinia/nuxt": "^1.0.3",
    "dompurify": "^3.4.17",
    "markdown-it": "^15.0.3",
    "nuxt": "^4.6.2",
    "pinia": "^4.1.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@graphql-codegen/cli": "^7.4.6",
    "@graphql-codegen/client-preset": "^6.2.3",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@nuxt/test-utils": "^4.3.4",
    "@playwright/test": "^1.64.1",
    "@types/jsdom": "^30.0.0",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.5",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vite-pwa/nuxt": "^1.1.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "graphql": "^17.0.2",
    "happy-dom": "^21.0.4",
    "jsdom": "^30.1.3",
    "typescript": "~6.0.3",
    "ultracite": "^8.1.0",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13",
    "wrangler": "^4.152.0"
  },
  "packageManager": "pnpm@12.8.1+sha512.f64ba907507f5ceafe06c8d38e6052d0179444580ec1279ddd5bfc11cb48aa8a2644b66598e07e761da84872a9fc57d5f902b87fa49d024198d558612aabbe45",
  "engines": {
    "node": "^24.21.0"
  }
}
